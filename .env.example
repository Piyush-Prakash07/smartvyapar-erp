# ==============================================================================
# SmartVyapar ERP — Environment Variables Template
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartvyapar?schema=public"

# Authentication & Security Secrets (Generate secure random 32+ char strings)
JWT_ACCESS_SECRET="your-32-character-random-jwt-access-secret"
JWT_REFRESH_SECRET="your-32-character-random-jwt-refresh-secret"

# Server Configuration
PORT=5000
NODE_ENV="development"

# CORS Allowed Origins (Comma-separated)
FRONTEND_URL="http://localhost:5173"
FRONTEND_URLS="http://localhost:5173,http://127.0.0.1:5173"

# SMTP Email Configuration (Optional in Dev - OTP codes will log to console)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-smtp-login-email"
SMTP_PASS="your-smtp-master-key"
SMTP_FROM="SmartVyapar ERP <no-reply@smartvyapar.com>"

# Frontend API URL (Set in frontend/.env when running client separately)
VITE_API_URL="http://localhost:5000/api/v1"
