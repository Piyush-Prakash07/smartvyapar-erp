# Database (PostgreSQL / Neon / Supabase / Railway / Render)
DATABASE_URL="postgresql://username:password@hostname:5432/finance_tracker?sslmode=require"

# JWT Secrets (Generate secure random 32+ char strings)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# Port & Environment
PORT=5000
NODE_ENV="production"

# Frontend Allowed Origins (CORS)
FRONTEND_URL="https://app.smartvyapar.com"
FRONTEND_URLS="https://app.smartvyapar.com,https://smartvyapar.com"

# SMTP Mailer Settings (e.g. Brevo, SendGrid, Amazon SES, Gmail, Mailgun)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM='"SmartVyapar ERP" <no-reply@smartvyapar.com>'

# Alternative Mail Provider Variable Format (Supported)
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="smtp-username"
MAIL_PASSWORD="smtp-password"
MAIL_FROM='"SmartVyapar ERP" <no-reply@smartvyapar.com>'
